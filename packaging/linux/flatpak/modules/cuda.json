{
  "name": "cuda",
  "build-options": {
    "no_debuginfo": true
  },
  "buildsystem": "simple",
  "cleanup": [
    "*"
  ],
  "build-commands": [
    "set -eu; case \"$FLATPAK_ARCH\" in x86_64) target=x86_64-linux ;; aarch64) target=sbsa-linux ;; *) echo \"Unsupported CUDA Flatpak architecture: $FLATPAK_ARCH\" >&2; exit 1 ;; esac; mv cuda/include/fatbinary_section.h \"cuda/targets/$target/include/\"",
    "test -x cuda/bin/nvcc",
    "mv cuda \"$FLATPAK_DEST/\""
  ],
