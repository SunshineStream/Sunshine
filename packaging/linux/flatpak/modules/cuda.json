{
  "name": "cuda",
  "build-options": {
    "no_debuginfo": true,
    "prepend-ld-library-path": "/app/lib:/app/lib64"
  },
  "buildsystem": "simple",
  "cleanup": [
    "*"
  ],
  "build-commands": [
    "chmod u+x ./cuda.run",
    "./cuda.run --silent --toolkit --toolkitpath=$FLATPAK_DEST/cuda --no-man-page --tmpdir=$FLATPAK_BUILDER_BUILDDIR || { echo '=== cuda-installer.log ==='; cat /tmp/cuda-installer.log 2>/dev/null; true; }",
    "test -f $FLATPAK_DEST/cuda/bin/nvcc",
    "rm -rf $FLATPAK_DEST/cuda/nsight-systems-*",
    "rm ./cuda.run"
  ],
  "modules": [
    {
      "name": "libxml2",
      "config-opts": [
        "--without-python",
        "--without-debug",
        "--without-history"
      ],
      "cleanup": [
        "/share",
        "/include",
        "/bin"
      ],
      "sources": [
        {
          "type": "git",
          "x-renovate": {
            "datasource": "github-tags",
            "depName": "GNOME/libxml2",
            "versioning": "regex:^v(?<major>[0-9]+)[.](?<minor>[0-9]+)[.](?<patch>[0-9]+)$"
          },
          "url": "https://github.com/GNOME/libxml2.git",
          "tag": "v2.13.9",
          "commit": "04af2cabb9f859c198b8a553c028a87481199410",
          "x-checker-data": {
            "type": "git"
          }
        }
      ]
    }
  ],
  "sources": [
    {
      "type": "file",
      "only-arches": [
        "x86_64"
      ],
      "x-renovate": {
        "depName": "cuda",
        "enabled": false
      },
      "url": "https://developer.download.nvidia.com/compute/cuda/13.5.0/local_installers/cuda_13.5.0_linux.run",
      "sha256": "1937d4d55633b699b539581dfa7e443f74d83cfe6dde455ba5f0f4f514914236",
      "dest-filename": "cuda.run",
      "x-checker-data": {
        "type": "html",
        "url": "https://developer.nvidia.com/cuda-downloads",
        "pattern": "(https://developer[.]download[.]nvidia[.]com/compute/cuda/([0-9]+[.][0-9]+[.][0-9]+)/local_installers/cuda_[0-9]+[.][0-9]+[.][0-9]+(?:_[0-9.]+)?_linux[.]run)"
      }
    },
    {
      "type": "file",
      "only-arches": [
        "aarch64"
      ],
      "x-renovate": {
        "depName": "cuda",
        "enabled": false
      },
      "url": "https://developer.download.nvidia.com/compute/cuda/13.5.0/local_installers/cuda_13.5.0_linux_sbsa.run",
      "sha256": "f13c0b09e44447d9d20186bd367bdcf2b365494f4ae5fa9e581446cf198e92f9",
      "dest-filename": "cuda.run",
      "x-checker-data": {
        "type": "html",
        "url": "https://developer.nvidia.com/cuda-downloads",
        "pattern": "(https://developer[.]download[.]nvidia[.]com/compute/cuda/([0-9]+[.][0-9]+[.][0-9]+)/local_installers/cuda_[0-9]+[.][0-9]+[.][0-9]+(?:_[0-9.]+)?_linux_sbsa[.]run)"
      }
    }
  ]
}
