{
  "name": "xvfb",
  "buildsystem": "meson",
  "config-opts": [
    "-Dxorg=true",
    "-Dxvfb=true",
    "-Dhal=false"
  ],
  "build-commands": [
    "install -Dm755 ../xvfb-run /app/bin/xvfb-run"
  ],
  "sources": [
    {
      "type": "git",
      "x-renovate": {
        "datasource": "github-tags",
        "depName": "xorg/xserver",
        "packageName": "LizardByte-infrastructure/xserver",
        "versioning": "regex:^xorg-server-(?<major>[0-9]+)[.](?<minor>[0-9]+)[.](?<patch>[0-9]+)$"
      },
      "url": "https://github.com/LizardByte-infrastructure/xserver.git",
      "tag": "xorg-server-21.1.13",
      "commit": "be2767845d6ed3c6dbd25a151051294d0908a995",
      "x-checker-data": {
        "type": "anitya",
        "project-id": 5250,
        "stable-only": true,
        "tag-template": "xorg-server-$version"
      }
    },
    {
      "type": "file",
      "path": "xvfb-run"
    }
  ],
  "modules": [
    {
